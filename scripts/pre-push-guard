#!/bin/bash
# Pre-push guard: what may reach the PUBLIC remote.
#
# Install with:
#   cp scripts/pre-push-guard .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#   (or: scripts/install_hooks.sh)
#
# WHY: the private archive (~/git_archive/accounts.git) holds the pre-scrub
# history, including the commits that carried config.yaml with the live
# database password. It is the safety net and must NEVER reach GitHub.
#
#   git push --all    pushes refs/heads/*  -- safe on its own.
#   git push --mirror pushes EVERY ref, including refs/remotes/*, so it
#                     would publish the archive's secret-bearing lineage.
#
# That is a one-keystroke-away leak, so it is blocked structurally rather
# than left to discipline. Verified: --mirror and an explicit
# refs/heads/archive-head are both REFUSED.
#
# 2026-10-29: GitHub's branch protection now REFUSES a direct push to
# main ("protected branch hook declined"), so the only publish path left
# is a branch plus a Pull Request. This guard used to refuse every ref
# except main -- which meant it refused the only path GitHub accepts.
# It now allows the branch patterns used for PRs, under a PROOF rather
# than a convention.
#
# The proof: the pushed history must be a PURE EXTENSION of the
# published main. Formally, every commit the push would add must have
# all of its parents either already in the published main or already
# among the commits being added.
#
# The first version of that rule only asked whether the branch DESCENDED
# from the published main -- and the self-test caught the hole: a merge
# commit whose second parent is a foreign root still descends from the
# published main, while dragging that foreign lineage into the public
# repository. That is exactly the leak this guard exists to prevent, so
# the rule is now stated over PARENTS, not over ancestry.
#
# Rules for the public remote:
#   - a DELETION is always allowed (a delete refspec has an all-zero
#     local sha; deleting can only remove objects).
#   - refs/heads/main is allowed -- GitHub's own protection decides.
#   - refs/heads/{feat,fix,publish}/* are allowed ONLY if the pushed
#     history is a pure extension of the published main.
#   - every other ref is REFUSED.
#
# Self-test: scripts/pre_push_guard_selftest.sh
set -uo pipefail

remote="$1"
ZERO_SHA="0000000000000000000000000000000000000000"

is_public_remote() {
  case "$1" in
    github|gh-peristyle_ai-accounts) return 0 ;;
    *) return 1 ;;
  esac
}

published_main_sha() {
  # The sha the public remote currently has on refs/heads/main.
  local sha
  sha=$(git ls-remote "$remote" refs/heads/main 2>/dev/null | awk 'NR==1{print $1}')
  if [ -z "$sha" ]; then
    # Fall back to the last known remote-tracking ref.
    sha=$(git rev-parse --verify --quiet "refs/remotes/$remote/main" 2>/dev/null || true)
  fi
  printf '%s' "$sha"
}

# is_pure_extension <published-sha> <pushed-sha>
#
# True when every commit the push would add has all of its parents
# either already in the published main or already among the commits
# being added. A branch that merely DESCENDS from the published main
# can still merge a foreign root in; this walks the parents, so that
# case is caught.
is_pure_extension() {
  local published="$1" sha="$2" new p
  new="$(git rev-list "$sha" --not "$published" 2>/dev/null)" || return 1
  [ -n "$new" ] || return 0
  for c in $new; do
    # `cut -s` matters: without it, cut PRINTS a line that has no
    # delimiter unchanged -- so a root commit's own sha came back as
    # its "parent", and a foreign root passed the check.
    parents="$(git rev-list --parents -n1 "$c" 2>/dev/null | cut -s -d' ' -f2-)"
    if [ -z "$parents" ]; then
      # A commit with NO parents is a ROOT. The published main already
      # has the root; adding a second one is what "two roots" means,
      # and it is how a foreign lineage gets spliced in.
      return 1
    fi
    for p in $parents; do
      [ -n "$p" ] || continue
      if printf '%s\n' "$new" | grep -qx "$p"; then
        continue
      fi
      if git merge-base --is-ancestor "$p" "$published" 2>/dev/null; then
        continue
      fi
      return 1
    done
  done
  return 0
}

# The tree about to be PUBLISHED must carry no identifier. This is a
# CONTENT check, not a structural one: the guard below proves which
# refs may be pushed and that the history extends the published main.
# Neither can see a customer's name inside a file.
#
# The scan runs against the PUSHED TREE, not the working tree: a branch
# may be checked out at something else entirely, and what is published
# is the tree of the commit being pushed.
#
# WHERE THE SCANNER COMES FROM -- this is the part that failed open.
#
# The first version of this looked for the scanner in the WORKING
# TREE. That made the gate's presence depend on which checkout the
# push happened from: the prod checkout sits on `main`, which (before
# the gate was merged) had no scanner at all, so every push from it
# printed "(no identifier scanner found -- skipping)" and published
# UNSCANNED. A gate that is absent was being treated as a gate that
# passes -- and the skip was announced in parentheses, which is not how
# a safety control should report itself.
#
# So the scanner is located in the PUSHED TREE and in the PUBLISHED
# MAIN, never in the working tree:
#
#   - published main has one, pushed tree does not  -> REFUSE. A branch
#     must not remove the gate.
#   - published main has one, pushed tree has one   -> run BOTH. The
#     published one is the reviewed one, so a branch cannot weaken the
#     gate by shipping a scanner that finds nothing.
#   - published main has none, pushed tree has one  -> run the pushed
#     one. This is the branch that INTRODUCES the gate.
#   - neither has one                              -> warn loudly and
#     allow: there is no gate to bypass, and refusing would make the
#     repository unpublishable until the gate lands.
#
# Every scanner is run against the PUSHED TREE (--commit), so what is
# checked is exactly what would be published.
IDENT_PATH="scripts/check_no_identifiers.py"

run_scanner() {  # run_scanner <scanner-file> <sha> <repo-root>
  local scanner="$1" sha="$2" repo_root="$3" out
  if ! out="$(python3 "$scanner" --repo "$repo_root" --commit "$sha" 2>&1)"; then
    echo "REFUSED: the tree being pushed carries an identifier." >&2
    printf '%s\n' "$out" | sed 's/^/         /' >&2
    return 1
  fi
  return 0
}

scan_pushed_tree() {
  local sha="$1" repo_root published tmp_push tmp_pub have_push=0 have_pub=0
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  published="$(published_main_sha)"

  tmp_push="$(mktemp "${TMPDIR:-/tmp}/ident_scanner.XXXXXX.py")" || return 1
  tmp_pub="$(mktemp "${TMPDIR:-/tmp}/ident_scanner_pub.XXXXXX.py")" || return 1

  # The scanner from the PUSHED TREE.
  if git cat-file -e "${sha}:${IDENT_PATH}" 2>/dev/null; then
    git show "${sha}:${IDENT_PATH}" >"$tmp_push" 2>/dev/null && have_push=1
  fi

  # The scanner from the PUBLISHED MAIN -- the reviewed one.
  if [ -n "$published" ] && git cat-file -e "${published}:${IDENT_PATH}" 2>/dev/null; then
    git show "${published}:${IDENT_PATH}" >"$tmp_pub" 2>/dev/null && have_pub=1
  fi

  if [ "$have_pub" = 1 ] && [ "$have_push" = 0 ]; then
    echo "REFUSED: the tree being pushed does not carry the identifier" >&2
    echo "         scanner, but the published main does. A branch must" >&2
    echo "         not remove the gate." >&2
    rm -f "$tmp_push" "$tmp_pub"
    return 1
  fi

  if [ "$have_push" = 0 ] && [ "$have_pub" = 0 ]; then
    echo "         WARNING: no identifier scanner is available (neither in" >&2
    echo "         the tree being pushed nor in the published main), so" >&2
    echo "         this push is NOT scanned for identifiers. The gate does" >&2
    echo "         not exist yet in this repository's history." >&2
    rm -f "$tmp_push" "$tmp_pub"
    return 0
  fi

  local rc=0 same=0
  # The two copies are the same file when their bytes match.
  if [ "$have_pub" = 1 ] && [ "$have_push" = 1 ]; then
    cmp -s "$tmp_pub" "$tmp_push" && same=1
  fi

  if [ "$have_pub" = 1 ]; then
    run_scanner "$tmp_pub" "$sha" "$repo_root" || rc=1
  fi
  # The pushed tree's own scanner is run too, unless it is byte-identical
  # to the published one that has just been run. A branch that ships a
  # WEAKENED scanner cannot silence the published one.
  if [ "$have_push" = 1 ] && [ "$same" = 0 ]; then
    run_scanner "$tmp_push" "$sha" "$repo_root" || rc=1
  fi

  rm -f "$tmp_push" "$tmp_pub"
  return $rc
}

if is_public_remote "$remote"; then
  while read -r _local_ref _local_sha _remote_ref _remote_sha; do
    if [ "$_local_sha" = "$ZERO_SHA" ]; then
      continue
    fi
    if ! scan_pushed_tree "$_local_sha"; then
      exit 1
    fi
    if [ "$_remote_ref" = "refs/heads/main" ]; then
      continue
    fi
    case "$_remote_ref" in
      refs/heads/feat/*|refs/heads/fix/*|refs/heads/publish/*)
        published="$(published_main_sha)"
        if [ -z "$published" ]; then
          echo "REFUSED: cannot determine the published main on '$remote', so" >&2
          echo "         the branch's ancestry cannot be proven." >&2
          exit 1
        fi
        if ! git cat-file -e "${published}^{commit}" 2>/dev/null; then
          echo "REFUSED: the published main ($published) is not in this" >&2
          echo "         clone, so the branch's ancestry cannot be proven." >&2
          echo "         Fetch it first: git fetch $remote main" >&2
          exit 1
        fi
        if is_pure_extension "$published" "$_local_sha"; then
          continue
        fi
        echo "REFUSED: pushing '$_remote_ref' to '$remote'." >&2
        echo "         The branch is not a pure extension of the published" >&2
        echo "         main ($published): it carries a parent that the" >&2
        echo "         published main does not have. That parent may be" >&2
        echo "         from the archive's pre-scrub lineage, whose" >&2
        echo "         config.yaml held the retired database password." >&2
        echo "         Rebase the branch onto the published main (git rebase" >&2
        echo "         --onto <published-main> <old-base> <branch>) and" >&2
        echo "         push again." >&2
        exit 1
        ;;
      *)
        echo "REFUSED: pushing '$_remote_ref' to the public remote '$remote'." >&2
        echo "         Only refs/heads/main and the PR branch patterns" >&2
        echo "         (feat/*, fix/*, publish/*) may be published. The" >&2
        echo "         private archive holds the pre-scrub history (including" >&2
        echo "         the old config.yaml password) and must never be." >&2
        echo "         (Deleting a ref is allowed -- it can only remove.)" >&2
        exit 1
        ;;
    esac
  done
fi
exit 0
