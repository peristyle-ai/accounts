# Peristyle Accounts — Environment configuration template
#
# Copy this file to `.env` and fill in real values for your install:
#   cp .env.example .env
#   chmod 600 .env  (so only your user can read it)
#
# `.env` is git-ignored. Never commit real secrets.
#
# Each var below has a comment explaining what it's for and a sensible
# default if you leave it unset. The defaults are designed for a clean
# local dev install — production / staging should set every var explicitly.

# ============================================================================
# Flask core
# ============================================================================

# Flask session signing key. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Required in production — leave unset only for ephemeral dev work.
SECRET_KEY=

# ============================================================================
# Database
# ============================================================================

# PostgreSQL connection. Either set DATABASE_URL directly OR the individual
# DB_* vars (which are assembled into DATABASE_URL by app/__init__.py).
# Use the EXPLICIT driver (postgresql+psycopg2://). A bare
# 'postgresql://' URL is ambiguous: SQLAlchemy 2.1 resolves it to psycopg
# (v3), so an install that only has psycopg2-binary fails to connect.
DATABASE_URL=postgresql+psycopg2://postgres@localhost/accounts

# Individual connection settings (used when DATABASE_URL is not set).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=accounts
DB_USER=postgres
DB_PASSWORD=

# ============================================================================
# Outbound email (mail server API)
# ============================================================================
# Peristyle Accounts sends payslips + invoices via an external mail server API
# (the local mail service running on your LAN). These vars
# point the client at that API and authenticate it.

# Base URL of the mail server (no trailing slash).
# The mail server speaks HTTPS with a self-signed certificate, so the URL
# must be https:// and MAIL_SERVER_CA_BUNDLE must point at the CA that
# signed it (see below) -- otherwise TLS verification fails.
#
# Replace the placeholder below with your mail server's real URL. The
# application REFUSES a value that still points at a reserved
# documentation domain (example.com / example.org / example.net / .test /
# .example / .invalid): such a host can never be a real mail server.
MAIL_SERVER_API=https://mail.example.com

# Base URL the accounts API is served on. Used by the API client in
# skills/accounts/ (AccountingSkill). There is NO built-in default --
# the client raises if this is unset.
ACCOUNTS_BASE_URL=http://127.0.0.1:5061

# API key for that base URL.
ACCOUNTS_API_KEY=

# Financial institution abbreviation written into the header record of
# an ABA (bulk payment) file -- positions 21-23, 3 characters, from the
# APCA financial institution list. It identifies YOUR bank.
ABA_FI_ABBREVIATION=NAB

# Mail server credentials (used to authenticate before sending).
MAIL_SERVER_USER=
MAIL_SERVER_PASSWORD=

# CA bundle that signed the mail server's certificate. Point this at the
# .crt/.pem the mail server's operator gave you. Unset means "use the
# system trust store", which is correct only for a publicly-trusted cert.
MAIL_SERVER_CA_BUNDLE=

# The From: address on outbound payslip + invoice emails. Should be a
# domain you control (for SPF/DKIM pass). Required for any mail flow
# that sends via the API above.
MAIL_FROM_ADDRESS=
MAIL_FROM_DOMAIN=

# ============================================================================
# Payroll — PII encryption
# ============================================================================
# Fernet key used by app/shared/pii.py to encrypt TFN, DOB, bank account
# numbers, etc. at rest. Without this, the app refuses to start.
#
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# IMPORTANT: rotating this key requires re-encrypting every PII column.
# Don't lose this value — if you do, encrypted PII becomes unreadable.
PAYROLL_PII_KEY=

# ============================================================================
# Uploads
# ============================================================================
# Where uploaded files (invoice PDFs, logos, expense receipts, pay-event
# attachments) are stored on disk. Defaults to "uploads" relative to the
# working directory if unset. Use an absolute path in production.
UPLOAD_FOLDER=uploads

# ============================================================================
# Payroll tooling (optional)
# ============================================================================
#
# The scripts/ folder drives the weekly payroll cycle. They locate the
# workspace that holds the mail credentials, the SSL bundle and the
# generated payroll files through the variables below. Leave them unset
# for a checkout that only runs the app.

# Workspace directory holding .env, ssl/ and the payroll/ output folder.
# EVIE_WORKSPACE=~/workspace
# PAYROLL_WORKSPACE=~/workspace

# Directory holding the employee's own payroll config.py (rate, standard
# week, encrypted-TFN lookup). Defaults to <workspace>/payroll/employee.
# PAYROLL_EMPLOYEE_CONFIG_DIR=~/workspace/payroll/employee

# Where the payroll scripts write the upload files.
# PAYROLL_DIR=~/workspace/payroll

# Address the weekly run emails the upload files to.
# PAYROLL_FILES_TO=you@yourcompany.com.au

# Name used in the greeting of the upload-file email.
# PAYROLL_OPERATOR_NAME=there

# The business user's email address. The test suite runs against a real
# deployment and needs to know which user owns the data; tests that need
# it skip themselves when this is unset.
# TEST_BUSINESS_EMAIL=you@yourcompany.com.au

# ============================================================================
# Third-party APIs
# ============================================================================

# Twelve Data (market data for the reporting features). Free tier works
# with rate limits; paid tier has a higher quota.
TWELVE_DATA_API_KEY=

# ============================================================================
# Receipt OCR
# ============================================================================
# The OCR pipeline (processes/ocr_processor.py) uses local tesseract plus a
# regex parser -- no model server and no API key. Install the tesseract
# binaries and poppler-utils on the host that runs the OCR processor.
# Low-confidence parses are flagged for manual review by an agent.

# ============================================================================
# Database schema mode (optional)
# ============================================================================
#
# By default the accounts tables install into the 'public' schema of the
# database named by DB_NAME, and the app owns its own 'users' table there.
# That is the simplest install and needs no configuration below.
#
# ACCOUNTS_SCHEMA -- set this to install the accounts tables into a
# dedicated schema instead of 'public'. Use this when the app shares a
# database with other applications and you want the accounts tables
# namespaced away from theirs. When it is set, run
#
#     python3 init_db.py --mode=schema
#
# to create the schema and install the DDL into it. init_db.py sets the
# session's search_path so every table in schema/init.sql lands in the
# configured schema.
#
# ACCOUNTS_SCHEMA=accounts
#
# USERS_TABLE -- the auth table the app reads and writes. It defaults to
# <ACCOUNTS_SCHEMA>.users, i.e. the app owns its own users table.
#
# Point this at an existing table only when a separate identity provider
# owns the auth table (a single sign-on service, a shared platform
# account). The table must already exist and must have at least the
# columns id, email and password_hash; init_db.py checks for them and
# refuses to continue if any are missing. When USERS_TABLE points
# somewhere else, init_db.py will NOT create a users table for you.
#
# USERS_TABLE=public.users
